# Mobile App Environment Configuration
# Leave EXPO_PUBLIC_API_URL unset to let the app auto-detect (emulator alias,
# localhost, or LAN). Set it only to force a specific backend.
EXPO_PUBLIC_API_URL="http://localhost:4000/api/v1"
# Set to this machine's LAN IP (e.g. 192.168.1.20) to test on a physical device.
EXPO_PUBLIC_API_HOST=

# Supabase Auth Client Credentials
EXPO_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-supabase-publishable-anon-key"

# Crash Reporting (optional)
# Leave unset to keep Sentry fully inert (no init, no events sent). Set to a
# Sentry project DSN to start reporting crashes and errors.
EXPO_PUBLIC_SENTRY_DSN=
